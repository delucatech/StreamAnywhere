{
  "name": "StreamAnywhere",
  "short_name": "StreamAnywhere",
  "description": "TikTok and YouTube feeds in a canvas video player",
  "start_url": "/home.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ]
}
