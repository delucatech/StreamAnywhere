# ---- Server (server/.env or environment) ----
# Port the Fastify resolver/proxy listens on
PORT=8787
# Comma-separated browser origins allowed to call the API (CORS). Use * only for local experiments.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Extra upstream hosts the media proxy may relay (comma-separated, exact host or *.suffix).
# TikTok CDN hosts and the bundled test-MP4 hosts are always allowed.
PROXY_ALLOWED_HOSTS=
# Resolver strategy: auto (native scraper, then yt-dlp), native, ytdlp
RESOLVER=auto
# Path to a yt-dlp executable. If unset, "yt-dlp" on PATH, pip --user installs and "python -m yt_dlp" are tried.
# TikTok falls back to it; YouTube (search, Shorts, formats) needs it.
YTDLP_PATH=
# Python that can `import yt_dlp` for the warm daemons (default: /opt/ytdlp/bin/python3, python3, python, py -3;
# a zipapp named by YTDLP_PATH is put on its sys.path). YTDLP_DAEMONS = how many (default 2); YTDLP_DAEMON=0 = CLI only.
YTDLP_PYTHON=
# Serve the built client (client/dist) from the server in production: true/false
SERVE_CLIENT=false
# Site password: scrypt hash (see server/src/auth.ts for the command); empty = the built-in one, off = no password
APP_PASSWORD_HASH=
# Secret that signs the login cookie. Empty = a random key generated on first start and kept in
# <dir of TIKTOK_PROFILE_DIR>/cookie-secret (APP_COOKIE_SECRET_FILE overrides the path).
APP_COOKIE_SECRET=
# Reverse proxies whose X-Forwarded-For/-Proto to trust (Fastify trustProxy): loopback (default, Caddy on
# the same host), true (any proxy, e.g. a hosting platform), false (none)
TRUST_PROXY=loopback
# Log level: info | debug
LOG_LEVEL=info
# Feed page sign-in (For You): Chrome/Edge executable (auto-detected when empty) and the browser
# profile directory that keeps the TikTok session (default ~/.streamanywhere/tiktok-profile).
BROWSER_PATH=
TIKTOK_PROFILE_DIR=
# YouTube / Instagram / Facebook sign-ins: Netscape cookies.txt files (defaults under ~/.streamanywhere/; treat like passwords)
YOUTUBE_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=
FACEBOOK_COOKIES_FILE=
# Facebook: the saved Page listings (a cache; deleting it is harmless)
FACEBOOK_CATALOG_FILE=
# Video Library: where the shared list of saved links (library.json) and the cached thumbnails live
# (default: <dir of TIKTOK_PROFILE_DIR>/library, i.e. /var/lib/streamanywhere/library on the VM, ~/.streamanywhere/library on a PC)
LIBRARY_DIR=
# "Download to library" keeps videos on the server (LIBRARY_DIR/files): one file at most DOWNLOAD_MAX_BYTES
# (default 2 GB), all of them together at most this many bytes (default 15 GB; the VM's disk is 30 GB)
LIBRARY_FILES_MAX_BYTES=
# Set to 0 to disable the sign-in feature (the feed page then offers Explore only)
ENABLE_BROWSER_SESSION=1
# Mirror (the phone's screen to the Tesla): STUN servers offered for the direct link (comma-separated), and an
# optional TURN relay (urls + credentials) for a direct link that still needs a relay; the StreamAnywhere relay
# itself (/api/mirror/ws) needs nothing.
MIRROR_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
MIRROR_TURN_URLS=
MIRROR_TURN_USERNAME=
MIRROR_TURN_PASSWORD=
# Linux only: pass --no-sandbox to Chromium when it must run as root (set automatically for uid 0)
BROWSER_NO_SANDBOX=0

# ---- Client (client/.env) ----
# Where Vite's dev proxy forwards /api requests
VITE_API_TARGET=http://localhost:8787
