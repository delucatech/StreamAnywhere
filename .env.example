# ---- Server (server/.env or environment) ----
# Port the Fastify resolver/proxy listens on
PORT=8787
# Comma-separated browser origins allowed to call the API (CORS). Use * only for local experiments.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Extra upstream hosts the media proxy may relay (comma-separated, exact host or *.suffix).
# TikTok CDN hosts and the bundled test-MP4 hosts are always allowed.
PROXY_ALLOWED_HOSTS=
# Resolver strategy: auto (native scraper, then yt-dlp), native, ytdlp
RESOLVER=auto
# Path to a yt-dlp executable (optional). If unset, "yt-dlp" on PATH and "python -m yt_dlp" are tried.
YTDLP_PATH=
# Serve the built client (client/dist) from the server in production: true/false
SERVE_CLIENT=false
# Site password: scrypt hash (see server/src/auth.ts for the command); empty = the built-in one, off = no password
APP_PASSWORD_HASH=
# Secret that signs the login cookie. Empty = a random key generated on first start and kept in
# <dir of TIKTOK_PROFILE_DIR>/cookie-secret (APP_COOKIE_SECRET_FILE overrides the path).
APP_COOKIE_SECRET=
# Reverse proxies whose X-Forwarded-For/-Proto to trust (Fastify trustProxy): loopback (default, Caddy on
# the same host), true (any proxy, e.g. a hosting platform), false (none)
TRUST_PROXY=loopback
# Log level: info | debug
LOG_LEVEL=info
# Feed page sign-in (For You): Chrome/Edge executable (auto-detected when empty) and the browser
# profile directory that keeps the TikTok session (default ~/.streamanywhere/tiktok-profile).
BROWSER_PATH=
TIKTOK_PROFILE_DIR=
# Set to 0 to disable the sign-in feature (the feed page then offers Explore only)
ENABLE_BROWSER_SESSION=1
# Linux only: pass --no-sandbox to Chromium when it must run as root (set automatically for uid 0)
BROWSER_NO_SANDBOX=0

# ---- Client (client/.env) ----
# Where Vite's dev proxy forwards /api requests
VITE_API_TARGET=http://localhost:8787
