<Project Sdk="Microsoft.NET.Sdk">

	<!-- The Broadcast Upload Extension: iOS hands it the screen's frames and the app's sound once the
	     user starts a broadcast and picks "StreamAnywhere". It runs in its own process (50 MB limit)
	     and talks to the app only through the App Group (settings in, status out).
	     Embedded in the MAUI app through the ProjectReference in StreamAnywhere.csproj (IsAppExtension). -->
	<PropertyGroup>
		<TargetFramework>net10.0-ios</TargetFramework>
		<OutputType>Library</OutputType>
		<IsAppExtension>true</IsAppExtension>
		<SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
		<RootNamespace>StreamAnywhere.Broadcast</RootNamespace>
		<ApplicationId>com.delucatech.streamanywhere.broadcast</ApplicationId>
		<ApplicationTitle>StreamAnywhere</ApplicationTitle>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
		<!-- the extension's memory limit: keep the bundle small -->
		<MtouchLink>SdkOnly</MtouchLink>
		<UseInterpreter>false</UseInterpreter>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Restore runs this project on its own, with no RuntimeIdentifier, and must cover every RID the app can
		     ask for: Visual Studio builds the app with RuntimeIdentifier=iossimulator-arm64 or ios-arm64 as a
		     global property, which the iOS SDK's extension build inherits, and the app's own build passes its RID
		     (StreamAnywhere.csproj, _ReferenceBroadcastExtension). With only the default RID restored, the
		     build fails with NETSDK1047. Only when no RID is given (RuntimeIdentifier, or the IDE's
		     _iOSRuntimeIdentifier that the SDK turns into one): with one, the SDK would drop this list anyway
		     (with a warning), and it must never build all three at once (they mix device and simulator). -->
		<RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == '' And '$(_iOSRuntimeIdentifier)' == ''">ios-arm64;iossimulator-arm64;iossimulator-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<!-- the viewer page the phone serves on its hotspot (built by `npm run build:mirror-local -w client`) -->
		<BundleResource Include="..\..\mirror\ios\Shared\Resources\viewer.html" Link="viewer.html" />
	</ItemGroup>

</Project>
